# qafe.ba – environment variables
# Copy to .env and fill in. Never commit .env. Values below are placeholders.
# Variables marked (phase N) are read starting from that phase.

# ---------- General ----------
NODE_ENV=development
# Base domain. Local: qafe.localhost (browsers resolve *.localhost to 127.0.0.1).
DOMAIN=qafe.localhost

# ---------- Ports (local) ----------
# api and worker read PORT inside their container; these are the host ports in dev.
API_PORT=3000
WORKER_PORT=3001
GUEST_PORT=5173
STAFF_PORT=5174
PANEL_PORT=5175
ADMIN_PORT=5176

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qafe
# Admin role (superuser): runs migrations and the seed only. Apps never use it.
POSTGRES_ADMIN_USER=qafe_admin
POSTGRES_ADMIN_PASSWORD=change-me
# Same credentials as a URL, for dbmate and kysely-codegen.
DATABASE_ADMIN_URL=postgres://qafe_admin:change-me@localhost:5432/qafe?sslmode=disable
# One login role per module; each sees only its own schema.
SVC_CORE_PASSWORD=change-me
SVC_CATALOG_PASSWORD=change-me
SVC_ORDERING_PASSWORD=change-me
SVC_BILLING_PASSWORD=change-me
SVC_AUDIT_PASSWORD=change-me
SVC_REPORTING_PASSWORD=change-me

# ---------- Worker ----------
# How often the outbox relay looks for new events (ms).
OUTBOX_POLL_MS=1000

# ---------- Redis (phase 4) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---------- Auth ----------
# core signs JWTs with an Ed25519 key (EdDSA) and exposes JWKS. Generate with: pnpm keys:generate
# Paths are relative to the repo root.
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt-public.pem
JWT_ISSUER=https://api.qafe.localhost
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# Path of the refresh-token cookie. Behind the Vite dev proxy (/api stripped) use /api/auth.
AUTH_COOKIE_PATH=/auth
# TOTP for platform admins (FR-ADM-01). Off for now; the columns and flow are prepared.
ADMIN_MFA_REQUIRED=false
# Key for encrypting TOTP secrets at rest (32 bytes, base64).
MFA_ENCRYPTION_KEY=
# Signs the guest table-session cookie.
GUEST_SESSION_SECRET=change-me

# ---------- Seed (pnpm db:seed, development only) ----------
SEED_ADMIN_EMAIL=admin@qafe.ba
SEED_ADMIN_PASSWORD=change-me
# Password for the demo venue's owner (sef) and waiter (konobar).
SEED_STAFF_PASSWORD=change-me

# ---------- Web Push (phase 5) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@qafe.ba

# ---------- Object storage: menu images and logos (S3 / MinIO) ----------
# s3 = MinIO locally, any S3-compatible store in production. memory = tests only.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_MENU_IMAGES=menu-images
# Local MinIO uses these as its root user (secret: at least 8 characters).
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8
# Where browsers load images from.
S3_PUBLIC_URL=http://localhost:9000/menu-images
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Observability (phase 3) ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
