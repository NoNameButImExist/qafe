# qafe.ba – environment variables
# Copy to .env and fill in. Never commit .env. Values below are placeholders.
# Variables marked (phase N) are read starting from that phase.

# ---------- General ----------
# Host `pnpm dev` reads this file as is; the Docker stack (make up) reads it too and replaces
# hosts and ports with the containers' (see docker-compose.yml).
NODE_ENV=development
# Base domain. Guests use <slug>.<DOMAIN>; the API reads the venue from that host.
# Local: qafe.localhost (browsers resolve *.localhost to 127.0.0.1).
DOMAIN=qafe.localhost

# ---------- Ports (local) ----------
# api and worker read PORT inside their container; these are the host ports in dev.
API_PORT=3000
WORKER_PORT=3001
GUEST_PORT=5173
STAFF_PORT=5174
PANEL_PORT=5175
ADMIN_PORT=5176

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qafe
# Admin role (superuser): runs migrations and the seed only. Apps never use it.
POSTGRES_ADMIN_USER=qafe_admin
POSTGRES_ADMIN_PASSWORD=change-me
# Same credentials as a URL, for dbmate and kysely-codegen.
DATABASE_ADMIN_URL=postgres://qafe_admin:change-me@localhost:5432/qafe?sslmode=disable
# One login role per module; each sees only its own schema.
SVC_CORE_PASSWORD=change-me
SVC_CATALOG_PASSWORD=change-me
SVC_ORDERING_PASSWORD=change-me
SVC_BILLING_PASSWORD=change-me
SVC_AUDIT_PASSWORD=change-me
SVC_REPORTING_PASSWORD=change-me

# ---------- Worker ----------
# How often the outbox relay looks for new events (ms).
OUTBOX_POLL_MS=1000

# ---------- Redis (cache, rate limits, realtime; never a source of truth) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ---------- Auth ----------
# core signs JWTs with an Ed25519 key (EdDSA) and exposes JWKS. Generate with: pnpm keys:generate
# Paths are relative to the repo root.
JWT_PRIVATE_KEY_PATH=secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=secrets/jwt-public.pem
JWT_ISSUER=https://api.qafe.localhost
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Proxies in front of the api in production (Traefik = 1; add 1 for a CDN such as Cloudflare).
TRUST_PROXY_HOPS=1
# Origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# Path of the refresh-token cookie. Behind the Vite dev proxy (/api stripped) use /api/auth.
AUTH_COOKIE_PATH=/auth
# Two-factor sign-in (TOTP) for platform admins (FR-ADM-01): each admin turns it on in
# "Moj nalog". true = admins without it cannot sign in (turn on only when all have it).
ADMIN_MFA_REQUIRED=false
# Encrypts TOTP secrets at rest (32 bytes, base64): openssl rand -base64 32. Empty = 2FA off.
MFA_ENCRYPTION_KEY=
# HMAC key for the guest device cookie (at least 16 characters). Only the hash is stored.
GUEST_SESSION_SECRET=change-me-at-least-16

# ---------- Guest app ----------
# Address a table's QR code opens; {slug} and {token} are filled in.
# *.localhost resolves to 127.0.0.1 in browsers, so subdomains work locally too.
GUEST_URL_TEMPLATE=https://{slug}.qafe.ba/t/{token}

# ---------- Seed (pnpm db:seed, development only) ----------
SEED_ADMIN_EMAIL=admin@qafe.ba
SEED_ADMIN_PASSWORD=change-me
# Password for the demo venue's owner (sef) and waiter (konobar).
SEED_STAFF_PASSWORD=change-me

# ---------- Web Push for staff (FR-KON-05) ----------
# Generate once with: pnpm keys:vapid. Empty = no push. The api reads the public key, the worker both.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@qafe.ba

# ---------- Object storage: menu images and logos (S3 / MinIO) ----------
# s3 = MinIO locally, any S3-compatible store in production. memory = tests only.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_MENU_IMAGES=menu-images
# Local MinIO uses these as its root user (secret: at least 8 characters).
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8
# Where browsers load images from.
S3_PUBLIC_URL=http://localhost:9000/menu-images
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Observability (phase 3) ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# ---------- Docker stack (make up / docker-compose.yml) ----------
# Traefik's port on this machine (http://panel.qafe.localhost etc.).
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8081
# Images: <QAFE_IMAGE_PREFIX>-<app>:<tag>. Locally built as qafe-api:local etc.
# On a server: QAFE_IMAGE_PREFIX=ghcr.io/<owner>/qafe and QAFE_TAG=latest (or API_TAG=0.3.0 ...).
QAFE_IMAGE_PREFIX=qafe
QAFE_TAG=local
# Secure cookies in Docker. The dev override turns them off for http on *.localhost.
# COOKIE_SECURE=true

# ---------- Production only (docker-compose.prod.yml) ----------
# Wildcard certificate for *.DOMAIN with the Let's Encrypt DNS challenge.
ACME_EMAIL=
ACME_DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=

# ---------------------------------------------------------------- backup (docker compose)
# Nightly encrypted pg_dump (`make backup` runs one now, `make backup-restore-test` restores
# the newest into a scratch database). Losing the passphrase means losing the backups.
BACKUP_PASSPHRASE=change-me-long-random
BACKUP_BUCKET=backups
BACKUP_AT=02:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Audit log months older than this move to S3 (NFR-25 requires at least 12).
AUDIT_RETENTION_MONTHS=24
# Off-site S3 on a server (empty = the MinIO of this stack):
# BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=

# ---------------------------------------------------------------- monitoring (docker compose)
# Grafana on grafana.<DOMAIN> (profile monitoring, part of `make up`).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------- point-in-time recovery
# pgBackRest (postgres archives WAL, the pitr service backs up daily). Losing the passphrase
# means losing the backups. Locally the repository is a volume; on a server use S3 (HTTPS):
PITR_PASSPHRASE=change-me-long-random
PITR_REPO_TYPE=posix
PITR_RETENTION_FULL=2
PITR_AT=03:00
# PITR_REPO_TYPE=s3
# PITR_S3_BUCKET=qafe-pitr
# PITR_S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
# PITR_S3_REGION=eu-central-003
# PITR_S3_KEY=
# PITR_S3_SECRET=

# ---------------------------------------------------------------- scaling (docker compose)
# API processes behind Traefik (one Node process uses one CPU core) and connections per module
# pool in each (6 modules): API_REPLICAS x 6 x DB_POOL_MAX must stay under POSTGRES_MAX_CONNECTIONS.
API_REPLICAS=1
DB_POOL_MAX=10
POSTGRES_MAX_CONNECTIONS=300
