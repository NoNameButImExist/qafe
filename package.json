{
  "name": "qafe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "docker:infra": "docker compose --profile infra up -d --wait postgres redis minio && docker compose --profile infra up --no-log-prefix minio-bucket minio-policy",
    "docker:up": "docker compose --profile app up -d --build",
    "docker:down": "docker compose --profile '*' down",
    "docker:logs": "docker compose --profile '*' logs -f",
    "db:migrate": "pnpm --filter @qafe/db db:migrate",
    "db:rollback": "pnpm --filter @qafe/db db:rollback",
    "db:status": "pnpm --filter @qafe/db db:status",
    "db:reset": "pnpm --filter @qafe/db db:reset",
    "db:codegen": "pnpm --filter @qafe/db db:codegen && prettier --write packages/db/src/generated",
    "db:seed": "pnpm --filter @qafe/db build && pnpm --filter @qafe/auth build && pnpm --filter @qafe/db db:seed",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "keys:vapid": "pnpm --silent --filter @qafe/worker exec web-push generate-vapid-keys",
    "test:integration": "turbo run test:integration"
  },
  "prettier": "@qafe/config/prettier",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@qafe/config": "workspace:*",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3"
  }
}
