{
  "name": "@qafe/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "qafe.ba worker: outbox relay and BullMQ jobs.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@qafe/config": "workspace:*",
    "@types/node": "^24.19.0",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
