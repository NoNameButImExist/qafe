{
  "name": "@qafe/worker",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "qafe.ba worker: outbox relay and BullMQ jobs.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration"
  },
  "devDependencies": {
    "@qafe/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "pg": "^8.23.0",
    "testcontainers": "^12.2.0",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@qafe/contracts": "workspace:*",
    "@qafe/db": "workspace:*",
    "@qafe/observability": "workspace:*",
    "@qafe/redis": "workspace:*",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.6",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  }
}
