{
  "name": "@qafe/api",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "qafe.ba API: modular monolith (core, catalog, ordering, billing, audit, reporting).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@qafe/auth": "workspace:*",
    "@qafe/contracts": "workspace:*",
    "@qafe/db": "workspace:*",
    "@qafe/redis": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@qafe/config": "workspace:*",
    "@swc/core": "^1.16.12",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "socket.io-client": "^4.8.4",
    "testcontainers": "^12.2.0",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
