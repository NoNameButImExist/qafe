{
  "name": "@qafe/ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Shared React components, brand tokens (theme.css) and theme handling.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-i18next": "^17.0.0"
  },
  "devDependencies": {
    "@qafe/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@qafe/contracts": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0"
  }
}
